ight": 400, "font": "UDShinGoPro-Regular-90pv", "spans": [[114.94, 456.32, 151.18, 462.31]], "text": "米ドル・豪ドル"}, {"id": 73, "bbox": [208.74, 303.5, 222.03, 311.23], "vert": false, "size": 7.55, "color": 534654, "weight": 700, "font": "UDShinGoPro-Medium-90pv-", "spans": [[208.74, 303.5, 222.03, 311.23]], "text": "5年"}, {"id": 74, "bbox": [205.66, 317.69, 223.94, 325.42], "vert": false, "size": 7.55, "color": 534654, "weight": 700, "font": "UDShinGoPro-Medium-90pv-", "spans": [[205.66, 317.69, 223.94, 325.42]], "text": "10年"}, {"id": 75, "bbox": [65.85, 80.45, 97.05, 88.43], "vert": false, "size": 7.8, "color": 0, "weight": 700, "font": "UDShinGoPro-Medium-90pv-", "spans": [[65.85, 80.45, 97.05, 88.43]], "text": "ご選択例"}, {"id": 76, "bbox": [61.63, 100.7, 101.6, 107.35], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[61.63, 100.7, 101.6, 107.35]], "text": "自営業なので"}, {"id": 77, "bbox": [36.23, 112.4, 129.68, 119.05], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[36.23, 112.4, 129.68, 119.05]], "text": "公的年金の上乗せを考えたい。"}, {"id": 78, "bbox": [34.72, 124.1, 131.93, 130.75], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[34.72, 124.1, 131.93, 130.75]], "text": "家族への保障はあまり減らさず、"}, {"id": 79, "bbox": [37.49, 135.8, 128.42, 142.45], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[37.49, 135.8, 128.42, 142.45]], "text": "満期時の受取を大きくしたい。"}, {"id": 80, "bbox": [46.64, 222.09, 121.22, 228.74], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[46.64, 222.09, 121.22, 228.74]], "text": "家族に“のこす”お金は、"}, {"id": 81, "bbox": [49.77, 233.79, 117.35, 240.44], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[49.77, 233.79, 117.35, 240.44]], "text": "終身保険で準備済み。"}, {"id": 82, "bbox": [36.53, 245.49, 127.67, 252.14], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[36.53, 245.49, 127.67, 252.14]], "text": "自分の長生きに備えたいなぁ…"}, {"id": 83, "bbox": [54.33, 332.86, 110.0, 339.51], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "UDShinGoPro-Regular-90pv", "spans": [[54.33, 332.86, 60.83, 339.51], [61.22, 332.86, 110.0, 339.51]], "text": "○年後にまとまった"}, {"id": 84, "bbox": [53.97, 344.56, 112.85, 351.21], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[53.97, 344.56, 112.85, 351.21]], "text": "資金を準備したい。"}, {"id": 85, "bbox": [46.77, 356.26, 120.67, 362.91], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[46.77, 356.26, 120.67, 362.91]], "text": "その間の医療費などは、"}, {"id": 86, "bbox": [40.78, 367.96, 123.41, 374.61], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "Jun201Pro-Regular-90pv-R", "spans": [[40.78, 367.96, 123.41, 374.61]], "text": "“別で”確保しているので。"}, {"id": 87, "bbox": [575.9, 68.93, 610.59, 76.91], "vert": false, "size": 7.8, "color": 16777215, "weight": 700, "font": "FolkPro-Bold-90pv-RKSJ-H", "spans": [[575.9, 68.93, 610.59, 76.91]], "text": "ステップ2"}, {"id": 88, "bbox": [458.07, 89.55, 558.52, 102.85], "vert": false, "size": 13.0, "color": 42811, "weight": 700, "font": "UDShinGoPro-DeBold-90pv-", "spans": [[458.07, 89.55, 558.52, 102.85]], "text": "保険のしくみで、"}, {"id": 89, "bbox": [458.07, 105.8, 647.44, 119.1], "vert": false, "size": 13.0, "color": 42811, "weight": 700, "font": "UDShinGoPro-DeBold-90pv-", "spans": [[458.07, 105.8, 647.44, 119.1]], "text": "年金原資額を大きくしてお受取り"}, {"id": 90, "bbox": [276.5, 68.93, 311.19, 76.91], "vert": false, "size": 7.8, "color": 16777215, "weight": 700, "font": "FolkPro-Bold-90pv-RKSJ-H", "spans": [[276.5, 68.93, 311.19, 76.91]], "text": "ステップ1"}, {"id": 91, "bbox": [167.85, 89.55, 327.7, 102.85], "vert": false, "size": 13.0, "color": 42811, "weight": 700, "font": "UDShinGoPro-DeBold-90pv-", "spans": [[167.85, 89.55, 327.7, 102.85]], "text": "運用する通貨・期間をきめる"}, {"id": 92, "bbox": [168.72, 114.81, 332.45, 124.12], "vert": false, "size": 9.1, "color": 0, "weight": 400, "font": "UDShinGoPro-Regular-90pv", "spans": [[168.72, 114.81, 177.82, 124.12], [174.45, 114.81, 332.45, 124.12]], "text": "●“円より高い金利が期待できる外貨”、"}, {"id": 93, "bbox": [173.96, 130.09, 365.58, 139.4], "vert": false, "size": 9.1, "color": 0, "weight": 400, "font": "UDShinGoPro-Regular-90pv", "spans": [[173.96, 130.09, 365.58, 139.4]], "text": "“為替リスクのない円貨”どちらかを選びます。"}, {"id": 94, "bbox": [168.72, 147.32, 387.59, 156.63], "vert": false, "size": 9.1, "color": 0, "weight": 400, "font": "UDShinGoPro-Regular-90pv", "spans": [[168.72, 147.32, 177.82, 156.63], [178.96, 147.32, 387.59, 156.63]], "text": "●何年後に受け取りたいか、運用する期間を選びます。"}, {"id": 95, "bbox": [458.93, 130.48, 684.98, 139.78], "vert": false, "size": 9.1, "color": 0, "weight": 400, "font": "UDShinGoPro-Regular-90pv", "spans": [[458.93, 130.48, 684.98, 139.78]], "text": "運用期間中、死亡給付金額・解約返還金額を抑えることで、"}, {"id": 96, "bbox": [458.93, 145.75, 649.75, 155.06], "vert": false, "size": 9.1, "color": 0, "weight": 400, "font": "UDShinGoPro-Regular-90pv", "spans": [[458.93, 145.75, 649.75, 155.06]], "text": "運用期間満了時の年金原資額が大きくなります。"}, {"id": 97, "bbox": [154.07, 178.84, 223.64, 188.15], "vert": false, "size": 9.1, "color": 0, "weight": 700, "font": "UDShinGoPro-Medium-90pv-", "spans": [[154.07, 178.84, 188.45, 188.15], [185.2, 180.79, 223.64, 187.44]], "text": "しくみ図（イメージ）"}, {"id": 98, "bbox": [166.62, 195.8, 257.41, 202.45], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "ShinGoPro-Regular-90pv-R", "spans": [[166.62, 195.8, 257.41, 202.45]], "text": "・目標値の設定はできません。"}, {"id": 99, "bbox": [166.62, 205.55, 276.41, 212.2], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "ShinGoPro-Regular-90pv-R", "spans": [[166.62, 205.55, 276.41, 212.2]], "text": "・ご契約者と被保険者が異なる契約は"}, {"id": 100, "bbox": [169.32, 215.3, 223.35, 221.95], "vert": false, "size": 6.5, "color": 0, "weight": 400, "font": "ShinGoPro-Regular-90pv-R", "spans": [[169.32, 215.3, 223.35, 221.95]], "text": "取り扱いません。"}, {"id": 101, "bbox": [52.24, 508.94, 381.52, 516.92], "vert": false, "size": 7.8, "color": 12394273, "weight": 400, "font": "ShinGoPro-Regular-90pv-R", "spans": [[52.24, 508.94, 381.52, 516.92]], "text": "この保険には、お客さまに負担していただく費用があります。また、為替、解約時の市場金利の変動"}, {"id": 102, "bbox": [396.2, 508.94, 551.86, 516.92], "vert": false, "size": 7.8, "color": 12394273, "weight": 400, "font": "ShinGoPro-Regular-90pv-R", "spans": [[396.2, 508.94, 551.86, 516.92]], "text": "などによって損失が生じるおそれがあります。"}, {"id": 103, "bbox": [561.27, 509.12, 591.65, 516.43], "vert": false, "size": 7.15, "color": 16777215, "weight": 400, "font": "UDShinMGoPro-Regular-90p", "spans": [[561.27, 509.12, 591.65, 516.43]], "text": "P30～32"}, {"id": 104, "bbox": [11.78, 530.14, 17.11, 538.79], "vert": false, "size": 8.45, "color": 0, "weight": 700, "font": "GothicBBBPro-Medium-90pv", "spans": [[11.78, 530.14, 17.11, 538.79]], "text": "5"}, {"id": 105, "bbox": [758.23, 530.14, 763.55, 538.79], "vert": false, "size": 8.45, "color": 0, "weight": 700, "font": "GothicBBBPro-Medium-90pv", "spans": [[758.23, 530.14, 763.55, 538.79]], "text": "6"}, {"id": 106, "bbox": [107.26, 33.13, 142.11, 45.33], "vert": false, "size": 11.93, "color": 16777215, "weight": 700, "font": "UDShinGoPro-Medium-90pv-", "spans": [[107.26, 33.13, 142.11, 45.33]], "text": "100％"}, {"id": 107, "bbox": [37.41, 10.98, 148.09, 26.94], "vert": false, "size": 15.6, "color": 16777215, "weight": 700, "font": "UDShinGoPro-DeBold-90pv-", "spans": [[37.41, 10.98, 148.09, 26.94]], "text": "満期重視プラン"}, {"id": 108, "bbox": [331.56, 24.08, 624.35, 40.04], "vert": false, "size": 15.6, "color": 0, "weight": 700, "font": "UDShinGoPro-Medium-90pv-", "spans": [[331.56, 24.08, 624.35, 40.04]], "text": "満期時   の受取額をより大きくしたい方へ"}, {"id": 109, "bbox": [194.89, 27.89, 334.37, 38.53], "vert": false, "size": 10.4, "color": 0, "weight": 700, "font": "UDShinGoPro-Medium-90pv-", "spans": [[194.89, 27.89, 334.37, 38.53]], "text": "死亡保障・解約返還金を抑え、"}, {"id": 110, "bbox": [759.53, 186.82, 766.33, 236.87], "vert": true, "size": 6.97, "color": 16777215, "weight": 700, "font": "ShinGoPro-Medium-90pv-RK", "spans": [[759.53, 186.82, 766.33, 193.97], [759.53, 193.97, 766.33, 201.12], [759.53, 201.12, 766.33, 208.27], [759.53, 208.27, 766.33, 215.42], [759.53, 215.42, 766.33, 222.57], [759.53, 222.57, 766.33, 229.72], [759.53, 229.72, 766.33, 236.87]], "text": "満期重視プラン"}]