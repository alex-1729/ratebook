[
 {"name":"news","js":"IRV.app.go('news'); ({h1:document.querySelector('h1').innerText, sub:document.querySelector('#main .sub').innerText, stories:[...document.querySelectorAll('.smc.story')].map(x=>x.innerText.replace(/\\s+/g,' ')), topics:[...document.querySelectorAll('[data-cat]')].map(x=>x.innerText), rows:document.querySelectorAll('.nwi').length, count:document.querySelector('.lbline').innerText.replace(/\\s+/g,' '), nav:document.getElementById('nav-news').innerText})"},
 {"name":"news-conduct","js":"document.querySelector('[data-cat=regulatory_conduct]').click(); ({count:document.querySelector('.lbline').innerText.replace(/\\s+/g,' '), first:[...document.querySelectorAll('.nwi')].slice(0,5).map(x=>x.innerText.replace(/\\s+/g,' ').slice(0,220))})"},
 {"name":"news-insurer-all","js":"document.querySelector('[data-cat=\"\"]').click(); var s=document.getElementById('news-ins'); s.value='dfl'; s.dispatchEvent(new Event('change')); document.getElementById('news-all').click(); ({count:document.querySelector('.lbline').innerText.replace(/\\s+/g,' '), rows:document.querySelectorAll('.nwi').length})"},
 {"name":"news-sources","js":"var d=document.getElementById('news-sources'); d.open=true; d.scrollIntoView(); ({summary:d.querySelector('summary').innerText, rows:d.querySelectorAll('tbody tr').length, attention:[...d.querySelectorAll('td.st-failed')].map(x=>x.parentNode.innerText.replace(/\\s+/g,' ').slice(0,160))})"},
 {"name":"story","js":"var st=IRV.app.news.stories[0]; st ? (IRV.app.go('news',{story:st.id}), {h1:document.querySelector('h1').innerText, meta:document.querySelector('.meta').innerText, keyDates:document.querySelectorAll('table.kd tr').length, questions:document.querySelectorAll('ul.notes li').length, items:document.querySelectorAll('.nwi').length, tags:[...new Set([...document.querySelectorAll('.nwi .tag')].map(x=>x.innerText))]}) : 'no story'"},
 {"name":"product-news","js":"IRV.app.go('product',{id:'dfl-premier-receive-3'}); document.querySelector('[data-tab=news]').click(); ({tab:document.querySelector('[data-tab=news]').innerText, heads:[...document.querySelectorAll('h2')].map(x=>x.innerText.replace(/\\s+/g,' ')), rows:[...document.querySelectorAll('.nwi')].map(x=>x.innerText.replace(/\\s+/g,' ').slice(0,160))})"},
 {"name":"tools","js":"(async()=>{const t=IRV.chatToolHandlers; const a=await t.news({insurer:'dfl',topic:'product_launch'}); const b=await t.list_stories({}); const c=await t.list_insurers({}); return {news:{matched:a.matched, coverage:a.coverage, first:a.items[0]}, stories:b.stories.map(s=>[s.id,s.linked_items]), insurers:c.insurers.length, tiers:c.insurers.reduce((o,i)=>(o[i.coverage]=(o[i.coverage]||0)+1,o),{}), view:IRV.chatView().line}})()"},
 {"name":"data-news","js":"IRV.app.go('data'); new Promise(r=>setTimeout(()=>{ [...document.querySelectorAll('.tg')].find(b=>b.innerText==='News').click(); setTimeout(()=>r({rows:document.querySelectorAll('#main tbody tr').length, run:!!document.getElementById('news-run'), foot:document.querySelector('.foot').innerText}),400)},2500))"}
