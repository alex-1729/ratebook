# Python
.venv/
__pycache__/
*.pyc

# Electron app: dependencies and packaged builds
app/node_modules/
app/dist/

# Insurer documents: kept on disk for the app, not in git (copyrighted, large).
# Each insurer's docs/manifest.csv records the source URL, size and checksum.
sources/*/docs/**/*.pdf
# News-release PDFs saved as launch-date evidence: same rule; each product's on_sale_date_source
# records the URL and the snapshot path.
sources/*/pages/*.pdf
# Distributors' own product lists saved as evidence of who sells a product: same rule; each insurer's
# distributors/manifest.csv records the source URL, size and checksum.
sources/*/distributors/*.pdf

# Translated brochures and their working files (derived from the PDFs above)
translations/

# Tooling
.claude/worktrees/
.DS_Store

# Translation trial renders (derived from a brochure page)
reports/translation-trial/*.pdf
reports/translation-trial/*.png

# Rate spreads: regenerated by scripts/rate_spreads.py
data/markets/rate_spreads.csv
